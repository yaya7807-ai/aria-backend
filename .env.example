# Salin file ini jadi .env lalu isi sesuai komputer/server kamu
PORT=3000

# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aria_db
# true kalau pakai database cloud (Railway, Supabase, Neon)
DB_SSL=false

# Kunci rahasia yang harus dikirim alat lewat header x-api-key
# Bagikan ke tim hardware, JANGAN di-push ke GitHub
DEVICE_API_KEY=ganti-dengan-kunci-rahasia-panjang

# Node dianggap offline kalau tidak kirim data selama X menit
ONLINE_TIMEOUT_MINUTES=10

# Domain dashboard frontend (pakai * selama development)
CORS_ORIGIN=*
